	(text "Page 24 of datasheet:\nThe SDO/SA0 pin can be used to modify the less significant \nbit of the device address. If the SDO/SA0 pin is connected \nto the supply voltage, LSb is '1' (address 1101011b);\nelse if the SDO/SA0 pin is connected to ground, the LSb value \nis '0' (address 1101010b). This solution permits to connect \nand address two different inertial modules to the same I²C bus."
		(exclude_from_sim no)
		(at 216.408 37.084 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "633c3292-aea3-46d4-98d8-891ba9cba94b")
	)
